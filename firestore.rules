rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdministrator() {
      return signedIn() && userRole() == 'administrator';
    }

    function isTaskOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validTaskStatus(status) {
      return status in ['open', 'completed'];
    }

    function validTaskPriority(priority) {
      return priority in ['low', 'medium', 'high'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdministrator());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'traveler';
      allow update: if isAdministrator()
        || (signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.keys().hasOnly(['displayName', 'email', 'role', 'createdAt', 'updatedAt']));
      allow delete: if isAdministrator();
    }

    function validGuideEntry(data) {
      return data.keys().hasOnly([
          'name', 'category', 'summary', 'classification', 'tags',
          'description', 'travelAdvisory'
        ])
        && data.keys().hasAll(['name', 'category', 'summary', 'classification', 'tags'])
        && data.name is string
        && data.name.size() > 0 && data.name.size() <= 100
        && data.summary is string
        && data.summary.size() > 0 && data.summary.size() <= 1000
        && data.category in ['planet', 'species', 'place', 'technology', 'object']
        && data.classification in ['mostly-harmless', 'safe', 'caution', 'dangerous', 'legendary', 'unknown']
        && data.tags is list
        && data.tags.size() <= 20
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('travelAdvisory' in data) || (data.travelAdvisory is string && data.travelAdvisory.size() <= 500));
    }

    match /guideEntries/{entryId} {
      allow read: if signedIn();
      allow create, update: if isAdministrator() && validGuideEntry(request.resource.data);
      allow delete: if isAdministrator();
    }

    match /travelTasks/{taskId} {
      allow read: if isTaskOwner(resource.data.userId);

      allow create: if isTaskOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'description', 'status', 'priority', 'dueDate', 'createdAt', 'updatedAt', 'completedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && (!('description' in request.resource.data) || (
          request.resource.data.description is string
          && request.resource.data.description.size() <= 500
        ))
        && validTaskStatus(request.resource.data.status)
        && validTaskPriority(request.resource.data.priority);

      allow update: if isTaskOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'description', 'status', 'priority', 'dueDate', 'createdAt', 'updatedAt', 'completedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && (!('description' in request.resource.data) || (
          request.resource.data.description is string
          && request.resource.data.description.size() <= 500
        ))
        && validTaskStatus(request.resource.data.status)
        && validTaskPriority(request.resource.data.priority);

      allow delete: if isTaskOwner(resource.data.userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}